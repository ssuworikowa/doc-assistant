    "import torch\n",
    "\n",
    "x = torch.tensor([[1.0, 2.0], [3.0, 4.0]])\n",
    "print(x.shape)\n",
    "print(x.dtype)\n",
    "print(x + 1)\n",
    "print(x @ x)\n",
    "\n",
    "print(x.mean())\n",
    "print(x.sum(dim=0))"
   ]
