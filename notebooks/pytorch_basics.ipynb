     "output_type": "stream",
     "text": [
      "tensor(9., grad_fn=<PowBackward0>)\n",
      "Градиент (производная): tensor(6.)\n"
     ]
    }
   ],
   "source": [
    "w = torch.tensor(3.0, requires_grad=True)\n",
    "\n",
    "y = w ** 2\n",
    "\n",
    "y.backward()\n",
    "\n",
    "print(y)\n",
    "print(\"Градиент (производная):\", w.grad)"
